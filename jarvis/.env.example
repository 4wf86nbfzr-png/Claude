# ============================================================
# JARVIS — Beispiel für Umgebungsvariablen
# ------------------------------------------------------------
# Diese Datei nach `.env` kopieren und ausfüllen, ODER die Werte
# in der Anwendung unter Einstellungen -> Zugänge eintragen.
#
# Der Weg über die Anwendung ist der bessere: dort landen die
# Werte verschlüsselt im Schlüsselbund des Betriebssystems und
# stehen nicht als Klartext auf der Platte.
#
# Umgebungsvariablen sind gedacht für automatisierte Umgebungen
# und für Leute, die ihre Schlüssel ohnehin so verwalten.
# Ein in der Anwendung gesetzter Wert hat Vorrang.
#
# .env NIEMALS ins Repository einchecken (steht in .gitignore).
# ============================================================


# ---- Sprachmodell ------------------------------------------
# Voreinstellung ist Anthropic. Ohne diesen Schlüssel antwortet
# JARVIS nicht.
# Schlüssel: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Alternatives Modell; außerdem nötig für Spracherkennung
# (Whisper) und Sprachausgabe, solange dort OpenAI eingestellt ist.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ---- Websuche für die Firmenrecherche ---------------------
# Ohne Schlüssel nutzt JARVIS eine schlüssellose Notlösung
# (DuckDuckGo-HTML). Die funktioniert, wird aber häufig
# gedrosselt. Für ernsthafte Recherche einen der folgenden
# Dienste hinterlegen und in den Einstellungen auswählen.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# https://tavily.com/
TAVILY_API_KEY=
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=


# ---- Sprache (optional) ------------------------------------
# Alternative Spracherkennung: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Alternative Sprachausgabe: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=


# ---- E-Mail über SMTP -------------------------------------
# Server, Port, Benutzer und Absenderadresse stehen in den
# Einstellungen der Anwendung. Nur das Passwort gehört hierher.
# Bei Gmail und Microsoft 365 besser OAuth verwenden (siehe unten)
# oder ein anwendungsspezifisches Passwort erzeugen.
SMTP_PASSWORD=

# Nur nötig, um eingehende Antworten den Firmen zuzuordnen.
IMAP_PASSWORD=


# ---- E-Mail über Gmail (OAuth, empfohlen) -----------------
# In der Google Cloud Console ein Projekt anlegen, die Gmail API
# aktivieren und unter "Anmeldedaten" eine OAuth-Client-ID vom
# Typ "Desktop" erzeugen. Beide Werte hier oder in der Anwendung
# eintragen und danach in den Einstellungen "Mit Google anmelden"
# ausführen — das Refresh-Token setzt JARVIS dann selbst.
# https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Wird von JARVIS nach der Anmeldung gesetzt. Nicht von Hand
# ausfüllen.
GMAIL_REFRESH_TOKEN=
