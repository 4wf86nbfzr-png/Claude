# ======================================================================
# WerkPilot AI – Konfiguration. Kopieren nach .env und ausfüllen.
# Niemals echte Werte einchecken. Alles mit (Pflicht) muss vor dem
# Produktivstart gesetzt sein; validate_for_production() meldet Lücken.
# ======================================================================

# --- Allgemein ---------------------------------------------------------
ENV=development                      # development | test | production
DEBUG=false
BASE_URL=http://localhost:8000       # öffentliche URL des Backends (OAuth-Redirects, Webhooks)
FRONTEND_URL=http://localhost:3000   # öffentliche URL der Website/des Dashboards
CORS_ORIGINS=http://localhost:3000   # kommagetrennt

# --- Datenbank / Cache -------------------------------------------------
POSTGRES_USER=werkpilot
POSTGRES_PASSWORD=werkpilot          # (Pflicht) in Produktion ändern
POSTGRES_DB=werkpilot
# Nur ohne Docker nötig; in Compose wird DATABASE_URL aus den POSTGRES_* Werten gebildet:
DATABASE_URL=postgresql+asyncpg://werkpilot:werkpilot@localhost:5432/werkpilot
# REDIS_URL=redis://localhost:6379/0 # optional (Rate-Limit über mehrere Prozesse)

# --- Sicherheit --------------------------------------------------------
SECRET_KEY=change-me-please-use-32-random-chars-min      # (Pflicht) z.B. `openssl rand -hex 32`
ENCRYPTION_KEY=                      # (Pflicht) Fernet-Key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
COOKIE_SECURE=false                  # (Pflicht) in Produktion true
# COOKIE_DOMAIN=.werkpilot.de        # nur wenn API und Web auf Subdomains liegen
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY_HEADERS=false            # true hinter Reverse-Proxy (Caddy/Traefik/nginx)

# --- E-Mail-Versand ------------------------------------------------------
EMAIL_PROVIDER=console               # console | resend | smtp   (console = nur Protokoll, kein Versand!)
EMAIL_FROM="WerkPilot AI <noreply@ihre-domain.de>"
RESEND_API_KEY=                      # bei EMAIL_PROVIDER=resend
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_STARTTLS=true
INBOUND_EMAIL_WEBHOOK_SECRET=        # gemeinsames Secret für den Inbound-Mail-Webhook (siehe docs/integrationen.md)

# --- KI ------------------------------------------------------------------
LLM_PROVIDER=mock                    # mock | anthropic | openai   (mock = regelbasiert, keine Kosten, keine echte KI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_GLOBAL_DAILY_BUDGET_CENTS=2000    # harte Obergrenze pro Tag über alle Mandanten (Cent)
AI_TRIAL_TOTAL_BUDGET_CENTS=150      # Budget je Testphase
AI_PER_TASK_MAX_CENTS=20
TRIAL_DAYS=14
TRIAL_AI_CALLS_MAX=40

# --- Stripe (Testmodus zuerst!) -------------------------------------------
STRIPE_SECRET_KEY=                   # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=               # whsec_... (Endpoint: POST {BASE_URL}/api/billing/webhook)
STRIPE_PUBLISHABLE_KEY=              # optional, nur Anzeige

# --- Google Calendar (OAuth-Client "Webanwendung") -----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect-URI in der Google Cloud Console: {BASE_URL}/api/integrations/google-calendar/callback

# --- Betrieb ---------------------------------------------------------------
OPS_ALERT_EMAIL=                     # Empfänger für kritische Meldungen und Tagesbericht
OPS_ALERT_WEBHOOK_URL=               # optional: Slack/Matrix/Discord Incoming-Webhook
AUTONOMY_ENABLED=true                # false = kein geplanter Agentenlauf
BACKUP_DIR=./backups
DATA_RETENTION_DAYS_DEFAULT=365
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=4

# --- Frontend --------------------------------------------------------------
NOINDEX=1                            # 1 solange nicht live (robots: disallow); 0 für den Produktivstart

# --- Optional (Standardwerte in backend/app/core/config.py) -----------------------------
# Anzeigename der Anwendung
# APP_NAME=Clairify
# Mindestlänge für Passwörter (zusätzlich Prüfung auf häufige Wörter)
# PASSWORD_MIN_LENGTH=10
# KI-Aufrufe: Zeitlimit je Aufruf und maximale Ausgabe-Tokens
# LLM_TIMEOUT_SECONDS=45
# LLM_MAX_OUTPUT_TOKENS=1200
# SMTP (nur bei EMAIL_PROVIDER=smtp)
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# Download-Links der Desktop-/Mobil-Apps; leer = "In Vorbereitung" auf der Startseite
# DOWNLOAD_WINDOWS_URL=
# DOWNLOAD_MACOS_URL=
# DOWNLOAD_IOS_URL=
# DOWNLOAD_ANDROID_URL=
