# =====================================================================
# MITEINANDER -- Umgebungsvariablen
#
# Diese Datei wird eingecheckt und enthaelt NIEMALS echte Werte.
# Kopieren nach .env (mobile) bzw. .env.local (admin) und ausfuellen.
# =====================================================================

# --- Produktname -------------------------------------------------------
# Der Arbeitstitel ist an genau einer Stelle im Code hinterlegt
# (packages/core/src/config/app-config.ts) und wird hier ueberschrieben.
EXPO_PUBLIC_APP_NAME=MITEINANDER
EXPO_PUBLIC_APP_NAME_SHORT=MITEINANDER
EXPO_PUBLIC_APP_CLAIM=Hier finden Sie Menschen, die Sie im Alltag unterstützen.

# --- Verantwortliche Stelle (DSGVO) -----------------------------------
EXPO_PUBLIC_OPERATOR=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_EMAIL=
EXPO_PUBLIC_A11Y_EMAIL=

# --- Feature-Schalter (austauschbare Module) --------------------------
# Zahlungen sind im MVP aus. Erst einschalten, wenn ein echter
# Zahlungsdienstleister angebunden und rechtlich geprueft ist.
EXPO_PUBLIC_FEATURE_PAYMENTS=false
EXPO_PUBLIC_FEATURE_VIDEO=true
EXPO_PUBLIC_FEATURE_DGS_INTERPRETER=false
EXPO_PUBLIC_FEATURE_COST_BEARER=false

# --- Supabase ---------------------------------------------------------
# Der anon-Key ist oeffentlich; er schuetzt nichts. Der Schutz kommt
# ausschliesslich aus der Row-Level-Security (supabase/migrations).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig. Niemals in die App, niemals ins Repository.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Adminbereich -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mehrfaktor-Anmeldung ist fuer alle Verwaltungskonten Pflicht.
ADMIN_MFA_REQUIRED=true

# --- Videoanrufe (WebRTC) ---------------------------------------------
# Anbieter muss datenschutzkonform sein: Verarbeitung in der EU,
# Auftragsverarbeitungsvertrag, keine Aufzeichnung ohne Einwilligung.
WEBRTC_SIGNALING_URL=
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# --- Karten und Geokodierung ------------------------------------------
# Datensparsam: es werden nur gerundete Koordinaten verarbeitet.
MAP_TILES_URL=
GEOCODING_API_URL=

# --- Push-Benachrichtigungen ------------------------------------------
# Vorschauen sind inhaltsarm (packages/core/src/privacy/visibility.ts).
EXPO_PUSH_ACCESS_TOKEN=

# --- Speicher fuer Nachweise und Medien -------------------------------
# Privater Bucket, Upload-Scanning aktiv, signierte URLs mit kurzer Frist.
STORAGE_BUCKET_DOCUMENTS=nachweise
STORAGE_BUCKET_MEDIA=medien
STORAGE_SIGNED_URL_TTL_SECONDS=300
