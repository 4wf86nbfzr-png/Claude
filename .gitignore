# Abhängigkeiten der Formularfunktion — Vercel installiert sie aus package.json
node_modules/

# Das fertige Paket zum Hochladen — wird mit tools/paket-bauen.sh erzeugt
herm-website-netlify.zip

# Die gebündelte Funktion — Ergebnis von tools/paket-bauen.sh, keine Quelle.
# Die Quelle steht in api/_netlify.js.
netlify/functions/

# Die Website als eine Datei zum Durchklicken ohne Server — Ergebnis von
# tools/testdatei-bauen.py, 12 MB, jederzeit neu zu bauen. Keine Quelle.
herm-website-testdatei.html
herm-website-redesign-testdatei.html

# Sprachmodell fuer tools/film-vertonen.py — 110 MB, Bezug steht in README.md
tools/stimme/
.paket-cache/
tools/__pycache__/

# Das fertige Redesign-Paket — wird aus dem Ordner redesign/ geschnuert.
herm-website-redesign-neu.zip

# Der Ordner redesign/ ist eine GELIEFERTE Fassung, kein Bauergebnis: dort
# sind auch die gebuendelten Funktionen die Quelle, die wir haben.
!redesign/netlify/functions/
