# ----------------------------------------------------------------------------
# Jarvis -- Konfiguration
#
# Diese Datei nach `.env` kopieren und ausfuellen (`jarvis setup` macht das
# auch). Sie enthaelt Zugangsdaten, gehoert also NICHT in ein Repository:
#   cp .env.example .env && chmod 600 .env
#
# Pflicht fuer den Betrieb sind nur die ersten beiden Werte.
# ----------------------------------------------------------------------------

# === Telegram (Pflicht) =====================================================
# Bot bei @BotFather anlegen, Token hier eintragen.
TELEGRAM_BOT_TOKEN=
# Eigene numerische Telegram-ID (z. B. ueber @userinfobot). Mehrere mit Komma.
# Leer = niemand darf den Bot benutzen.
TELEGRAM_ALLOWED_IDS=
TELEGRAM_POLL_TIMEOUT=30
# Nur aendern, wenn ein eigener Bot-API-Server benutzt wird
# (https://github.com/tdlib/telegram-bot-api). Standard ist die offizielle API.
# TELEGRAM_API_BASE=https://api.telegram.org

# === Grundeinstellungen =====================================================
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LOG_LEVEL=INFO
# Wo Datenbank, Sicherungen und Protokolle liegen (Standard: ./data)
# JARVIS_DATA_DIR=/Users/ich/Library/Application Support/Jarvis

# === KI-Modell ==============================================================
# ollama (lokal, Voreinstellung) | openai | anthropic | echo (ohne KI)
AI_PROVIDER=ollama
AI_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
# Ersatzmodell, falls das erste nicht antwortet (optional)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_TIMEOUT=120
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.6
# Wie viele Nachrichten als Kontext mitgehen (der Rest steckt in der Zusammenfassung)
AI_CONTEXT_MESSAGES=16
AI_MAX_TOOL_ROUNDS=6
# Nur noetig, wenn AI_PROVIDER=openai bzw. anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Denktiefe bei den aktuellen Claude-Modellen: low | medium | high.
# "low" ist fuer einen Assistenten meist richtig: schneller und guenstiger.
# Leer lassen bei aelteren Modellen, die das Feld nicht kennen.
ANTHROPIC_EFFORT=low

# Modelle und Preise je Million Token (Stand 10/2026), falls AI_PROVIDER=anthropic:
#   claude-haiku-5-5    0,10 $ rein / 0,50 $ raus   -- guenstigste Wahl
#   claude-sonnet-5-5   2,00 $      / 10,00 $
#   claude-opus-5-5     4,00 $      / 20,00 $       -- staerkste Wahl
# Ein Tag Assistentenbetrieb liegt typischerweise im Bereich einiger Cent.
# Zu bedenken: dabei verlassen Aufgaben, Termine und Mailauszuege den Rechner.

# === Kalender ===============================================================
# local (in der Jarvis-Datenbank) | caldav (Apple, Nextcloud, mailbox.org) | google
CALENDAR_PROVIDER=local
# CalDAV, z. B. Apple: https://caldav.icloud.com/ mit app-spezifischem Passwort
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=
CALDAV_CALENDAR=
# Google: OAuth-Client (Typ "Desktop") in der Cloud Console anlegen,
# danach einmalig `jarvis google-login` ausfuehren.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# === E-Mail =================================================================
EMAIL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Nur abschalten, wenn der Mailserver auf demselben Rechner laeuft.
IMAP_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=
# Wie oft das Postfach geprueft wird (Sekunden)
EMAIL_POLL_SECONDS=300
# Wer und was als wichtig gilt (Komma-getrennt, Kleinschreibung)
EMAIL_IMPORTANT_SENDERS=
EMAIL_IMPORTANT_KEYWORDS=angebot,vertrag,rechnung,personalplanung

# === Telefonie (Twilio Voice) ===============================================
PHONE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Die bei Twilio gekaufte Nummer, international
TWILIO_FROM_NUMBER=
# Die eigene Nummer, die angerufen wird
PHONE_MY_NUMBER=
PHONE_VOICE=Google.de-DE-Standard-B
PHONE_LANGUAGE=de-DE
PHONE_MAX_ATTEMPTS=3
PHONE_RETRY_MINUTES=15
PHONE_DAILY_LIMIT=20
# Nur aendern, wenn Twilio eine andere Region vorgibt.
# TWILIO_API_BASE=https://api.twilio.com/2010-04-01

# === Sprachverarbeitung =====================================================
# twilio (nichts zu installieren) | whisper (lokal) | none
# whisper ist zusaetzlich die Voraussetzung dafuer, dass Jarvis
# Sprachnachrichten in Telegram auswerten kann.
STT_ENGINE=twilio
WHISPER_MODEL=base
WHISPER_BINARY=whisper
# twilio | piper (lokal) | say (macOS) | none
TTS_ENGINE=twilio
PIPER_BINARY=piper
PIPER_VOICE=

# === HTTP-Dienst (Dashboard, API, Telefonie-Rueckrufe) ======================
HTTP_ENABLED=true
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
# Lange Zufallszeichenfolge; ohne sie erlaubt die API nur localhost.
# Erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HTTP_API_TOKEN=
# Von aussen erreichbare HTTPS-Adresse (nur fuer Telefongespraeche noetig),
# z. B. ein Cloudflare- oder ngrok-Tunnel auf HTTP_PORT.
PUBLIC_BASE_URL=

# === Verhalten ==============================================================
# In der Ruhezeit kommen nur dringende Meldungen sofort.
# Beide leer lassen = keine Ruhezeit.
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
# Taeglicher Tagesueberblick (leer = aus)
MORNING_BRIEFING=07:30
SCHEDULER_TICK_SECONDS=20
BACKUP_KEEP=14
CONFIRMATION_TTL_MINUTES=15
# Ordner, aus denen Jarvis Dateien lesen darf (Doppelpunkt-getrennt)
# JARVIS_FILE_ROOTS=/Users/ich/Documents:/Users/ich/Projekte

# === Nachrichten (WhatsApp & Co.) ==========================================
# Jarvis liest eingehende Nachrichten mit, stuft sie ein und meldet nur,
# was dich angeht. Bei Absagen/Krankmeldungen ruft er an (wenn Telefonie laeuft).
MESSENGER_ENABLED=false
# mac     = Mitteilungen von WhatsApp Desktop mitlesen (nur macOS, rein lokal;
#           Terminal braucht Festplattenvollzugriff, sieht nur die Vorschau)
# bruecke = Nachrichten per HTTP annehmen (POST /api/nachricht/eingang)
# aus     = keine Quelle
MESSENGER_QUELLE=mac
MESSENGER_POLL_SECONDS=60
# Pfad zur Mitteilungsdatenbank, falls er abweicht (leer = Standard)
MESSENGER_MAC_DB=
# Kommagetrennt. Wer hier steht, wird immer gemeldet.
MESSENGER_WICHTIGE_ABSENDER=
# Eigene Stichwoerter, die sofort stoeren duerfen bzw. gemeldet werden.
MESSENGER_DRINGEND_WOERTER=
MESSENGER_WICHTIG_WOERTER=
# Gruppen, die nie gemeldet werden (Teil des Namens reicht).
MESSENGER_STUMME_GRUPPEN=
# Bei dringenden Nachrichten zusaetzlich anrufen.
MESSENGER_ANRUF_BEI_DRINGEND=true

# === Zwischenbericht ========================================================
# Wie oft Jarvis unaufgefordert berichtet, was er im Hintergrund getan hat.
# 0 = nie. Er schweigt, wenn nichts passiert ist.
BERICHT_INTERVALL_STUNDEN=3

# === Orb: Jarvis zum Sprechen (Browser) ====================================
# Oberflaeche unter http://127.0.0.1:8765/orb -- Chrome noetig (Spracheingabe).
ORB_ENABLED=true
# Wie Jarvis dich anspricht.
ORB_ANREDE=Sir
# Satz, der die Begruessung ausloest.
ORB_WECKWORT=jarvis aktivieren
# Zweimal klatschen faehrt das Setup hoch (Erkennung laeuft im Browser).
ORB_KLATSCHEN=true
# Programme, die dann starten. macOS-App-Namen, kommagetrennt.
# ORB_PROGRAMME=Spotify,Visual Studio Code,Obsidian
ORB_PROGRAMME=
# Seite, die dabei aufgeht.
# ORB_WEBSEITE=https://hermserviceteam.com
ORB_WEBSEITE=
# Darf Jarvis Programme starten, Seiten oeffnen, den Bildschirm ansehen?
ORB_AKTIONEN=true
# Stadt fuer die Wetterzeile in der Begruessung (leer = kein Wetter).
ORB_STADT=Hamburg
# Beschreibt Bildschirmfotos. Braucht ANTHROPIC_API_KEY.
VISION_MODELL=claude-haiku-5-5

# === ElevenLabs (die Stimme) ===============================================
# Ohne Schluessel spricht der Browser mit der Systemstimme -- alles laeuft,
# es klingt nur nicht nach Jarvis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
