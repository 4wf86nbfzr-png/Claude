# ─────────────────────────────────────────────────────────────────────────────
# JARVIS – Beispielkonfiguration
#
# Diese Datei nach `.env` kopieren und ausfüllen, oder bequemer:  npm run setup
#
# Gelesen wird in dieser Reihenfolge (der erste gesetzte Wert gewinnt):
#   1. echte Umgebungsvariablen
#   2. .env im Projektordner
#   3. .env im Datenverzeichnis
#      Linux:   ~/.local/share/jarvis/.env
#      macOS:   ~/Library/Application Support/jarvis/.env
#      Windows: %APPDATA%\jarvis\.env
#
# Geheimnisse gehören NICHT ins Repository. Besser: in der App unter
# Einstellungen → Zugangsdaten hinterlegen; sie landen dann im Schlüsselbund
# des Betriebssystems.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ablage ───────────────────────────────────────────────────────────────────
# JARVIS_DATA_DIR=/eigener/pfad
# JARVIS_DB_PATH=/eigener/pfad/jarvis.db

# Passphrase für den verschlüsselten Zugangsdaten-Tresor. Wird nur außerhalb
# der Desktop-App gebraucht (Setup-Assistent, Skripte). In der App übernimmt
# das der Schlüsselbund des Betriebssystems.
# JARVIS_MASTER_KEY=

# ── Sprachmodell ─────────────────────────────────────────────────────────────
# anthropic | openai-kompatibel | keiner
JARVIS_LLM_PROVIDER=anthropic
JARVIS_LLM_MODEL=claude-sonnet-5
JARVIS_LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

# Für "openai-kompatibel" – funktioniert auch mit Ollama oder LM Studio:
# JARVIS_LLM_BASE_URL=https://api.openai.com/v1
# JARVIS_LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# ── Spracherkennung (Sprache → Text) ─────────────────────────────────────────
# browser  = eingebaute Erkennung des Fensters (kein Schlüssel nötig)
# openai-kompatibel = Whisper-API oder ein lokaler Whisper-Server
JARVIS_STT_PROVIDER=browser
JARVIS_STT_MODEL=whisper-1
JARVIS_STT_LANGUAGE=de
# JARVIS_STT_BASE_URL=https://api.openai.com/v1
# JARVIS_STT_API_KEY=

# ── Sprachausgabe (Text → Sprache) ───────────────────────────────────────────
# browser | openai-kompatibel | elevenlabs
JARVIS_TTS_PROVIDER=browser
JARVIS_TTS_MODEL=tts-1
JARVIS_TTS_VOICE=onyx
# JARVIS_TTS_BASE_URL=https://api.openai.com/v1
# JARVIS_TTS_API_KEY=
# ELEVENLABS_API_KEY=

# ── Websuche für die Unternehmensrecherche ───────────────────────────────────
# brave | tavily | serpapi | keiner
JARVIS_SEARCH_PROVIDER=keiner
JARVIS_SEARCH_MAX_RESULTS=10
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# ── E-Mail-Versand ───────────────────────────────────────────────────────────
# smtp | gmail | keiner
JARVIS_MAIL_PROVIDER=keiner
MAIL_FROM_NAME=HERM Service Team
MAIL_FROM_ADDRESS=dispo@hermserviceteam.com
# MAIL_REPLY_TO=

# SMTP
# SMTP_HOST=smtp.ihr-anbieter.de
# SMTP_PORT=587
# SMTP_SECURE=false          # true nur bei Port 465
# SMTP_USER=
# SMTP_PASSWORD=

# Gmail über OAuth (bevorzugt gegenüber App-Passwörtern).
# OAuth-Client vom Typ "Desktop" in der Google Cloud Console anlegen,
# danach in der App: Einstellungen → Mit Google verbinden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=      # wird beim Verbinden selbst hinterlegt

# ── Posteingang (Antworten zuordnen) ─────────────────────────────────────────
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX

# ── Grenzen und Schutz ───────────────────────────────────────────────────────
JARVIS_DAILY_SEND_LIMIT=30           # Höchstzahl versendeter Nachrichten pro Tag
JARVIS_MAX_RECIPIENTS_PER_MAIL=3     # mehr Empfänger gilt als Rundmail und wird abgelehnt
JARVIS_APPROVAL_TTL_MINUTES=30       # Gültigkeitsdauer einer Freigabe
JARVIS_SEND_COOLDOWN_SECONDS=20      # Mindestabstand zwischen zwei Sendungen
JARVIS_DRY_RUN=true                  # Testbetrieb: nichts wird wirklich versendet

# ── Recherche ────────────────────────────────────────────────────────────────
JARVIS_RESPECT_ROBOTS=true
JARVIS_MIN_REQUEST_DELAY_MS=1000     # Mindestpause je Host
JARVIS_HTTP_TIMEOUT_MS=15000
JARVIS_MAX_PAGES_PER_COMPANY=6
# JARVIS_USER_AGENT=

# ── Absenderprofil (geht in Mailtexte und Signatur ein) ──────────────────────
JARVIS_SENDER_COMPANY=HERM Service Team e.K.
JARVIS_SENDER_PERSON=
JARVIS_SENDER_ROLE=
JARVIS_SENDER_PHONE=
JARVIS_SENDER_WEB=https://hermserviceteam.com
JARVIS_SENDER_ADDRESS=
# Eigene Signatur; ohne Angabe wird sie aus den Feldern oben gebaut.
# JARVIS_SENDER_SIGNATURE=
JARVIS_SENDER_OFFERING=Personaldienstleistung aus Hamburg: Sicherheitsdienst, Gastro- und Veranstaltungspersonal, Promotion, Logistik, Fahrservice und Reinigung.
