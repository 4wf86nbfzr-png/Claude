{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "outDir": "dist/main",
    "rootDir": "src"
  },
  // Das Preload wird von tsc nur geprueft; ausgeliefert wird die
  // gebuendelte Fassung aus vite.preload.config.mts (Sandbox laedt nur eine Datei).
  "include": ["src/core/**/*.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/setup/**/*.ts", "src/shared/**/*.ts"]
}
