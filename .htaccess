# ============================================================
# HERM Service Team — Konfiguration für Apache-Webspace
# ------------------------------------------------------------
# Wird gebraucht, wenn die Seite auf einem klassischen Webhosting
# liegt (Strato, IONOS, All-Inkl, Hetzner, Mittwald …).
# Auf Netlify und GitHub Pages hat die Datei keine Wirkung und
# stört auch nicht.
#
# Für die interne Vorschau: Ordner z. B. /vorschau/ anlegen,
# Inhalt hochladen, fertig.
# ============================================================

# ---- TESTBETRIEB: Passwortschutz ----
# Die zwei Zeilen einkommentieren und den Pfad anpassen. Wo die
# .htpasswd liegen muss, steht in der Hilfe Ihres Hosters; die
# meisten legen sie auch per Klick im Kundenmenü an.
#
# AuthType Basic
# AuthName "Interne Vorschau — HERM Service Team"
# AuthUserFile /pfad/zu/.htpasswd
# Require valid-user

# ---- TESTBETRIEB: VOR DEM LIVE-GANG ENTFERNEN ----
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# ---- Sicherheit ----
# Dieselben Kopfzeilen wie in vercel.json und netlify.toml. Sie standen hier
# nur zur Haelfte da: wer bei einem klassischen Hoster liegt, hatte damit
# weder Klickschutz noch HTTPS-Zwang noch eine Inhaltsrichtlinie.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  # Nur setzen, wenn die Seite wirklich per HTTPS ausgeliefert wird —
  # sonst sperrt man sich eine noch nicht umgestellte Domain selbst aus.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  # Die Seite laedt nichts von fremden Servern. 'unsafe-inline' ist noetig
  # fuer die Inline-Stile im Markup und die Zeile im <head>, die die
  # JS-Sperre aufhebt.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# ---- Dateitypen, die ältere Apache-Konfigurationen nicht kennen ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/webm .webm
  AddType image/webp .webp
  AddType image/avif .avif
  AddType text/vtt   .vtt
</IfModule>

# ---- Komprimierung ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml text/xml text/plain
</IfModule>

# ---- Zwischenspeicher ----
# Bilder, Schriften und Video ändern sich selten; HTML immer frisch
# holen, sonst sieht das Büro im Test noch den Stand von gestern.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType video/webm              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 week"
  ExpiresByType application/javascript  "access plus 1 week"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ---- Fehlerseite ----
ErrorDocument 404 /404.html

# ---- Keine Verzeichnislisten ----
Options -Indexes

# ---- Adressen ohne .html ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Adressen der bisherigen Website. /ueber-uns/ und /news/ gibt es hier
  # nicht mehr; ohne diese beiden Zeilen liefe jeder Treffer aus einer
  # Suchmaschine darauf ins 404.
  RewriteRule ^ueber-uns/?$ /team.html [R=301,L]
  RewriteRule ^news/?$ / [R=301,L]

  # Sonderfall: dienstleistungen.html liegt neben dem Ordner dienstleistungen/.
  # Die allgemeine Regel unten greift hier nicht, weil sie Verzeichnisse
  # ausnimmt (!-d) — ohne diese Zeile landete /dienstleistungen auf dem
  # leeren Ordner statt auf der Uebersichtsseite.
  RewriteRule ^dienstleistungen/?$ dienstleistungen.html [L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
