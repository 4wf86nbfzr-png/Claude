{
  "name": "jarvis-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "setup": "bash scripts/setup.sh",
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "simulate:call": "tsx scripts/simulate-call.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "connect:microsoft": "tsx scripts/connect-microsoft.ts",
    "connect:whatsapp": "tsx scripts/connect-whatsapp.ts",
    "configure:gateway": "tsx scripts/configure-gateway.ts",
    "bench:speech": "tsx scripts/bench-speech.ts",
    "dev": "tsx watch apps/orchestrator/src/main.ts",
    "start": "node apps/orchestrator/dist/main.js",
    "status": "tsx scripts/status.ts",
    "logs:safe": "bash scripts/logs-safe.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250"
  }
}
