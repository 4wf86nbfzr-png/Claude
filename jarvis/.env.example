# JARVIS — Zugänge
#
# Zwei Wege, ein Geheimnis zu hinterlegen:
#
#   a) In der App unter „Einrichtung → Zugänge". Dann liegt es verschlüsselt im
#      Schlüsselbund des Betriebssystems (Keychain / DPAPI / libsecret). Das ist
#      der empfohlene Weg für den Alltag.
#
#   b) Als Umgebungsvariable, wie hier beschrieben. Praktisch für Server,
#      Container und automatisierte Einrichtungen.
#
# Der Speicher in der App hat Vorrang; ist dort nichts hinterlegt, wird die
# Umgebungsvariable verwendet. Diese Datei nach `.env` kopieren, ausfüllen und
# vor dem Start der App in die Umgebung laden — sie wird NICHT automatisch
# eingelesen, damit kein Geheimnis unbemerkt aus dem Projektordner stammt:
#
#   set -a && . ./.env && set +a && npm start
#
# .env gehört nicht in die Versionsverwaltung.


# ---------------------------------------------------------------------------
# Sprachmodell — mindestens eines wird benötigt
# ---------------------------------------------------------------------------

# Anthropic (Voreinstellung, Modell claude-opus-5).
# Erhältlich unter https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# OpenAI — nötig für: OpenAI als Modellanbieter, Whisper-Spracherkennung,
# OpenAI-Sprachausgabe. Für Ollama wird kein Schlüssel gebraucht.
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Postausgang — je nach gewähltem Versandweg
# ---------------------------------------------------------------------------

# Variante SMTP: Passwort bzw. App-Passwort des Postfachs.
# Host, Port und Benutzer stehen in den Einstellungen der App.
SMTP_PASSWORD=

# Variante Gmail (OAuth). Client-ID steht in den Einstellungen der App.
# Das Refresh-Token einmalig erzeugen mit:  node scripts/gmail-auth.mjs
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Posteingang, damit Antworten dem angeschriebenen Unternehmen zugeordnet
# werden können. Optional, aber ohne IMAP bleibt „Antwort erhalten" leer.
IMAP_PASSWORD=


# ---------------------------------------------------------------------------
# Recherche — optional
# ---------------------------------------------------------------------------
# Ohne Schlüssel läuft die Suche über DuckDuckGo. Das funktioniert, liefert aber
# deutlich dünnere Treffer als die kostenpflichtigen Dienste.

# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# https://tavily.com
TAVILY_API_KEY=

# https://serpapi.com
SERPAPI_API_KEY=


# ---------------------------------------------------------------------------
# Sprachausgabe — optional
# ---------------------------------------------------------------------------
# Ohne Schlüssel spricht die eingebaute Systemstimme (Web Speech).

# https://elevenlabs.io
ELEVENLABS_API_KEY=


# ---------------------------------------------------------------------------
# Ablage
# ---------------------------------------------------------------------------
# Überschreibt den Ordner für Datenbank, Arbeitsdateien und Schlüsseldatei.
# Voreinstellung: der Nutzerdatenordner des Betriebssystems
#   macOS   ~/Library/Application Support/JARVIS
#   Windows %APPDATA%\JARVIS
#   Linux   ~/.config/JARVIS
# JARVIS_DATA_DIR=/pfad/zum/ordner
