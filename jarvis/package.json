{
  "name": "jarvis-desktop",
  "productName": "JARVIS",
  "version": "1.0.0",
  "description": "Lokaler Desktop-KI-Assistent mit Sprach- und Textsteuerung, Unternehmensrecherche und freigabepflichtigem E-Mail-Versand.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "author": "HERM Service Team e.K.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node --experimental-sqlite scripts/setup.mjs",
    "doctor": "node --experimental-sqlite scripts/doctor.mjs",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "cheerio": "^1.0.0",
    "imapflow": "^1.0.194",
    "nodemailer": "^7.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
