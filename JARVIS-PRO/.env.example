# ---------------------------------------------------------------------------
# Jarvis Pro - Beispielkonfiguration.
# Kopieren nach .env (nur lokale Entwicklung). Echte Geheimnisse gehoeren in
# den Secret Store (macOS Keychain / libsecret), NICHT in diese Datei.
# ---------------------------------------------------------------------------

NODE_ENV=development
JARVIS_MODE=simulation           # simulation | dry-run | live

# --- Bedienweg --------------------------------------------------------------
# telefon = SIP-Anschluss und Asterisk noetig
# chat    = nur WhatsApp Cloud API, keine Hardware, keine Sprachschicht
# beide   = Vollausbau
JARVIS_KANAL=beide

# --- Eigentuemer / Telefonie ------------------------------------------------
# Bei JARVIS_KANAL=chat sind die beiden Rufnummern nicht noetig.
JARVIS_OWNER_PHONE_E164=+490000000000
JARVIS_SIM_PHONE_E164=+490000000001
# scrypt-Hash der Login-PIN (erzeugen mit: pnpm tsx scripts/hash-pin.ts)
JARVIS_LOGIN_PIN_HASH=
# scrypt-Hash der Freigabe-PIN (muss sich von der Login-PIN unterscheiden)
JARVIS_APPROVAL_PIN_HASH=

# --- Asterisk ARI -----------------------------------------------------------
ARI_URL=http://127.0.0.1:8088
ARI_USER=jarvis
ARI_PASSWORD=
ARI_APP=jarvis
ARI_EXTERNAL_MEDIA_HOST=127.0.0.1:41000
ARI_EXTERNAL_MEDIA_TRANSPORT=websocket   # websocket | rtp

# --- Bedienung ueber WhatsApp -----------------------------------------------
# Deine eigene WhatsApp-Nummer, ohne fuehrendes Plus. Nur von dieser Nummer
# nimmt Jarvis Anweisungen an. Fehlt sie, startet der Chatbetrieb nicht.
JARVIS_OWNER_WA_ID=
# Nach dieser Pause (Minuten) beginnt ein neuer Gespraechsabschnitt, und der
# Pflichtsatz kommt wieder.
JARVIS_CHAT_IDLE_MINUTES=60
# Anmelde-PIN auch im Chat verlangen. Standard aus - siehe docs/whatsapp-weg.md.
JARVIS_CHAT_REQUIRE_LOGIN_PIN=false
# Zweiter Faktor fuer die Freigabe: pin | totp
# ACHTUNG: eine getippte PIN bleibt im Chatverlauf stehen. "totp" ist ein
# Einmalcode aus einer Authenticator-App und nach 30 Sekunden wertlos.
JARVIS_CHAT_SECOND_FACTOR=pin
# Wie viele Ereignisse hoechstens auf einmal gemeldet werden.
JARVIS_CHAT_MAX_ANNOUNCEMENTS=3
# Oeffentliche Adresse des Webhooks - nur fuer die Startplan-Pruefung.
WHATSAPP_WEBHOOK_URL=

# --- Datenschutz (Production-Defaults, nicht veraendern) --------------------
STORE_RAW_AUDIO=false
LOG_MESSAGE_BODIES=false

# --- Verhalten --------------------------------------------------------------
CALL_ON_EVERY_NEW_EMAIL=true
CALL_ON_EVERY_NEW_WHATSAPP=true
CALL_RETRY_SECONDS=120
CALL_MAX_PER_HOUR=60
APPROVAL_EXPIRES_SECONDS=180
DEFAULT_TIMEZONE=Europe/Berlin

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5

# --- Microsoft Graph (Delegated, Authorization Code + PKCE) -----------------
MS_TENANT_ID=consumers
MS_CLIENT_ID=
MS_REDIRECT_URI=http://localhost:53682/callback

# --- WhatsApp Business Cloud API (direkt bei Meta) --------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PORT=8787

# --- Speech -----------------------------------------------------------------
WHISPER_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_VOICE=

# --- Persistenz -------------------------------------------------------------
JARVIS_DB_PATH=./var/jarvis.db
JARVIS_DB_CIPHER=false
