# ------------------------------------------------------------
# DispoRex – Umgebungsvariablen (Vorlage; niemals echte Werte einchecken)
# ------------------------------------------------------------

# Anwendungsumgebung: development | test | production
NODE_ENV=development
APP_ENV=development
# Öffentliche Basis-URL (für Links in E-Mails, Einladungen, Passwort-Reset)
APP_URL=http://localhost:3000

# Datenbank – Verbindung für Migrationen (Tabellen-Eigentümer, darf RLS umgehen)
DATABASE_URL=postgres://disporex_owner:disporex@localhost:5432/disporex
# Datenbank – Verbindung der laufenden Anwendung (eingeschränkte Rolle, RLS greift)
DATABASE_APP_URL=postgres://disporex_app:disporex_app@localhost:5432/disporex
# Testdatenbank (wird von den Integrationstests benutzt und bei jedem Lauf zurückgesetzt)
DATABASE_TEST_URL=postgres://disporex_owner:disporex@localhost:5432/disporex_test

# Geheimnisse (mind. 32 zufällige Bytes, z. B. `openssl rand -base64 48`)
# Zum Verschlüsseln sensibler Spalten (Webhook-Secrets, SMTP-Passwörter in Tenant-Einstellungen)
APP_ENCRYPTION_KEY=
# Sitzungen
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# Dokumentenspeicher: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Nur bei STORAGE_DRIVER=s3 (S3-kompatibel, z. B. MinIO, Hetzner, AWS)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-Mail-Versand (SMTP). Ohne SMTP_HOST werden E-Mails nur protokolliert (Kanal "log").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DispoRex <noreply@example.com>"

# Eingehende E-Mails (IMAP-Abruf, optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
# Mandant, dem abgerufene Mails zugeordnet werden (UUID); leer = erster aktiver Mandant
IMAP_TENANT_ID=

# KI-Anbieter: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Monatliches Token-Budget je Mandant (0 = unbegrenzt)
AI_MONTHLY_TOKEN_BUDGET=2000000

# WhatsApp Business (Meta Cloud API) – optional, sonst bleibt der Kanal deaktiviert
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Hintergrund-Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4

# Rate Limiting (Anfragen pro Minute je Client)
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# Fehlerüberwachung (optional, Sentry-kompatibler DSN)
SENTRY_DSN=

# Protokollierung: debug | info | warn | error
LOG_LEVEL=info
