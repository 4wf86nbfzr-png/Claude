{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS – lokaler Desktop-KI-Assistent mit Agentensystem, Unternehmensrecherche und freigabepflichtigem E-Mail-Versand",
  "author": "HERM Service Team e.K.",
  "license": "UNLICENSED",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:node && npm run build:preload && npm run build:renderer",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "npm run build:node && node dist/main/setup/index.js",
    "dist": "npm run build && electron-builder",
    "build:preload": "vite build --config vite.preload.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "cheerio": "^1.2.0",
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hermserviceteam.jarvis",
    "productName": "JARVIS",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
