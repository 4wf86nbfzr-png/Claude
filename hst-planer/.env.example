# ------------------------------------------------------------------ Datenbank
DATABASE_URL="postgresql://hst:hst@localhost:5432/hstplaner?schema=public"

# ------------------------------------------------------------------ Sicherheit
# Mit `openssl rand -base64 48` erzeugen. NIEMALS im Quellcode ablegen.
AUTH_SECRET=""
# Basis-URL der Anwendung (fuer Links in E-Mails und Cookie-Einstellungen)
APP_URL="http://localhost:3000"
# Kommagetrennte Liste erlaubter Origins fuer die oeffentliche Website-API
PUBLIC_API_ORIGINS="https://hermserviceteam.com,https://www.hermserviceteam.com"
# Anfragen je IP und Stunde ueber POST /api/public/request
PUBLIC_REQUEST_LIMIT="5"

# ------------------------------------------------------------------ Postfach (IMAP – Eingang)
EMAIL_HOST=""
EMAIL_PORT="993"
EMAIL_SECURE="true"
EMAIL_USER="info@hermserviceteam.com"
EMAIL_PASSWORD=""
EMAIL_MAILBOX="INBOX"
# Verarbeitete Mails in diesen Ordner verschieben (leer = nur als gelesen markieren)
EMAIL_PROCESSED_MAILBOX=""

# ------------------------------------------------------------------ Versand (SMTP – Ausgang)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HST Planer <dispo@hermserviceteam.com>"
# Empfaenger der Dispositions-Benachrichtigungen
DISPO_NOTIFY_EMAIL="dispo@hermserviceteam.com"

# ------------------------------------------------------------------ Dateiablage
STORAGE_PATH="./storage"
MAX_UPLOAD_MB="20"

# ------------------------------------------------------------------ API
# Schluessel fuer die oeffentliche Website-Schnittstelle (POST /api/public/request)
API_SECRET=""

# ------------------------------------------------------------------ KI (optional)
# Ohne Schluessel arbeitet der E-Mail-Parser rein regelbasiert weiter.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
