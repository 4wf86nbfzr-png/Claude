{
  "name": "@jarvis/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS Desktop – Electron-Hauptprozess",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@jarvis/core": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "de.hermserviceteam.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS hört auf Ihr Schnipsen und auf gesprochene Anweisungen. Die Auswertung passiert auf diesem Rechner; es wird nichts aufgezeichnet und nichts verschickt.",
        "NSSpeechRecognitionUsageDescription": "Gesprochene Anweisungen werden auf diesem Rechner in Text umgewandelt."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
