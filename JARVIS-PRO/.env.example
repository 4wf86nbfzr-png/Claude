# ---------------------------------------------------------------------------
# Jarvis Pro - Beispielkonfiguration.
# Kopieren nach .env (nur lokale Entwicklung). Echte Geheimnisse gehoeren in
# den Secret Store (macOS Keychain / libsecret), NICHT in diese Datei.
# ---------------------------------------------------------------------------

NODE_ENV=development
JARVIS_MODE=simulation           # simulation | dry-run | live

# --- Eigentuemer / Telefonie ------------------------------------------------
JARVIS_OWNER_PHONE_E164=+490000000000
JARVIS_SIM_PHONE_E164=+490000000001
# scrypt-Hash der Login-PIN (erzeugen mit: pnpm tsx scripts/hash-pin.ts)
JARVIS_LOGIN_PIN_HASH=
# scrypt-Hash der Freigabe-PIN (muss sich von der Login-PIN unterscheiden)
JARVIS_APPROVAL_PIN_HASH=

# --- Asterisk ARI -----------------------------------------------------------
ARI_URL=http://127.0.0.1:8088
ARI_USER=jarvis
ARI_PASSWORD=
ARI_APP=jarvis
ARI_EXTERNAL_MEDIA_HOST=127.0.0.1:41000
ARI_EXTERNAL_MEDIA_TRANSPORT=websocket   # websocket | rtp

# --- Datenschutz (Production-Defaults, nicht veraendern) --------------------
STORE_RAW_AUDIO=false
LOG_MESSAGE_BODIES=false

# --- Verhalten --------------------------------------------------------------
CALL_ON_EVERY_NEW_EMAIL=true
CALL_ON_EVERY_NEW_WHATSAPP=true
CALL_RETRY_SECONDS=120
CALL_MAX_PER_HOUR=60
APPROVAL_EXPIRES_SECONDS=180
DEFAULT_TIMEZONE=Europe/Berlin

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5

# --- Microsoft Graph (Delegated, Authorization Code + PKCE) -----------------
MS_TENANT_ID=consumers
MS_CLIENT_ID=
MS_REDIRECT_URI=http://localhost:53682/callback

# --- WhatsApp Business Cloud API (direkt bei Meta) --------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PORT=8787

# --- Speech -----------------------------------------------------------------
WHISPER_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_VOICE=

# --- Persistenz -------------------------------------------------------------
JARVIS_DB_PATH=./var/jarvis.db
JARVIS_DB_CIPHER=false
