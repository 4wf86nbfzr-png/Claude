# ---------------------------------------------------------------------------
# JARVIS – Beispielkonfiguration
#
# Diese Datei nach .env kopieren und ausfüllen. Alles ist optional; was fehlt,
# meldet JARVIS beim Start im Klartext ("Einrichtung → Bereitschaft").
#
#   cp .env.example .env
#
# Zugangsdaten müssen NICHT hier stehen: der Einrichtungsassistent
# (npm run setup) und die Oberfläche legen sie im Schlüsselbund des
# Betriebssystems ab bzw. verschlüsselt im Datenverzeichnis. Werte aus dieser
# Datei haben Vorrang und werden nie überschrieben.
#
# .env gehört NICHT ins Repository (siehe .gitignore).
# ---------------------------------------------------------------------------

# --- Allgemein -------------------------------------------------------------
# Wo Datenbank, Anhänge und verschlüsselte Zugangsdaten liegen.
# Standard: ~/.jarvis
# JARVIS_DATA_DIR=/Users/ich/.jarvis
JARVIS_LOG_LEVEL=info
JARVIS_LOCALE=de-DE

# Passphrase für die verschlüsselte Zugangsdaten-Datei. Ohne Angabe erzeugt
# JARVIS eine Schlüsseldatei mit Rechten 0600 daneben. In der Desktop-App wird
# ohnehin der Schlüsselbund des Systems benutzt.
# JARVIS_SECRETS_PASSPHRASE=

# --- Sprachmodell ----------------------------------------------------------
# anthropic | openai | ollama
JARVIS_LLM_PROVIDER=anthropic
# Leer lassen für das Standardmodell des Anbieters.
# JARVIS_LLM_MODEL=claude-sonnet-4-5

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Lokales Modell – damit verlässt kein Firmendatum den Rechner.
# Das Modell muss Werkzeugaufrufe beherrschen (z. B. qwen2.5, llama3.1).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Websuche --------------------------------------------------------------
# tavily | brave | serpapi | duckduckgo
# duckduckgo braucht keinen Schlüssel, findet aber deutlich weniger und ist
# gegenüber Layoutänderungen empfindlich. Für ernsthafte Recherche: Tavily.
JARVIS_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# --- Sprache ---------------------------------------------------------------
# browser = im Fenster über die Web-Speech-Schnittstelle (kostenlos, keine
# Daten an Dritte bei der Ausgabe). openai = Whisper bzw. OpenAI-Stimmen.
JARVIS_STT_PROVIDER=browser
JARVIS_TTS_PROVIDER=browser
JARVIS_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Mailversand -----------------------------------------------------------
# smtp | gmail | graph | none
JARVIS_MAIL_TRANSPORT=none
JARVIS_MAIL_FROM_NAME=
JARVIS_MAIL_FROM_ADDRESS=
JARVIS_MAIL_REPLY_TO=

# SMTP – funktioniert mit jedem Postfach.
SMTP_HOST=
SMTP_PORT=587
# Bei Port 465 auf true setzen (implizites TLS), bei 587 leer lassen (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# IMAP – nur für das Zuordnen eingehender Antworten. Ohne IMAP funktioniert
# der Versand, aber "Antwort erhalten" bleibt leer.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# Gmail über OAuth (empfohlen für Google-Konten, kein App-Passwort nötig).
# Google Cloud Console → Anmeldedaten → OAuth-Client-ID, Typ "Desktop".
# Die Redirect-URI muss dort genauso eingetragen sein.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth/google

# Microsoft 365 / Outlook über Microsoft Graph.
# Entra-Portal → App-Registrierung, Plattform "Mobile and desktop".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://127.0.0.1:53683/oauth/microsoft

# --- Versandregeln (Compliance) --------------------------------------------
# Diese Grenzen sind bewusst konservativ. Sie schützen die Zustellbarkeit der
# eigenen Domain und verhindern, dass aus einer Kampagne versehentlich ein
# Massenversand wird.
JARVIS_MAX_SENDS_PER_HOUR=20
JARVIS_MAX_SENDS_PER_DAY=100
JARVIS_MIN_SEND_INTERVAL_SECONDS=20
# true = nur Adressen mit belegter Quelle dürfen angeschrieben werden.
# Auf false zu setzen ist selten eine gute Idee.
JARVIS_REQUIRE_VERIFIED_RECIPIENT=true

# --- Recherche -------------------------------------------------------------
JARVIS_HTTP_USER_AGENT=JarvisResearchBot/1.0 (+lokaler Assistent; respektiert robots.txt)
# robots.txt beachten. Abschalten heißt: fremde Seiten gegen ihren erklärten
# Willen abrufen. Bitte nur mit gutem Grund.
JARVIS_RESPECT_ROBOTS=true
JARVIS_FETCH_TIMEOUT_MS=15000
JARVIS_MAX_PAGE_BYTES=1500000
JARVIS_RESEARCH_CONCURRENCY=3
