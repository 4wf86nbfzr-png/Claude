{
  "name": "@miteinander/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "web:export": "expo export --platform web --output-dir dist",
    "e2e": "node e2e/kernablauf.mjs && node e2e/bedienhilfen.mjs && node e2e/gebaerdensprache.mjs",
    "testdatei": "expo export --platform web --output-dir dist && node tools/einzeldatei.mjs dist miteinander-testfassung.html"
  },
  "dependencies": {
    "@expo/metro-runtime": "*",
    "@miteinander/core": "*",
    "@miteinander/ui": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.0",
    "expo-av": "*",
    "expo-constants": "*",
    "expo-linking": "*",
    "expo-router": "~57.0.16",
    "expo-speech": "*",
    "expo-status-bar": "*",
    "expo-video": "^57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  }
}
