# ============================================================
# Zugangsdaten der Bruecke
# ------------------------------------------------------------
# Diese Datei nach ".env" kopieren und ausfuellen. Sie gehoert
# NICHT ins Repository (.gitignore sorgt dafuer) und sollte nur
# fuer den eigenen Benutzer lesbar sein:
#     chmod 600 .env
# ============================================================

# Zugang zu secplan.net. Nur noetig im Modus "browser".
# Empfehlenswert ist ein eigenes Konto "Bruecke" mit genau den
# Rechten, die fuer den Abgleich gebraucht werden — dann steht
# im secplan-Protokoll auch, was automatisch passiert ist.
SECPLAN_BENUTZER=
SECPLAN_PASSWORT=

# Schluessel fuer den Zugriff auf die Bruecke. Leer lassen —
# dann wird beim ersten Start einer erzeugt und in
# daten/token.txt abgelegt.
BRUECKE_TOKEN=

# Passwort des Mail-Postfachs, falls der Morgenlauf Mails
# verschicken soll. Alternativ steht es in konfig.json unter
# mail.smtp.auth.pass — hier ist es besser aufgehoben.
SMTP_PASSWORT=
